<?xml version="1.0"?>
<CPdocs type="PackExtender">
	<packextender name="ComplexAnalysis" abbrev="CA">
		<tooltip>Provides discrete versions of certain standard function theory notions</tooltip>
		<cmd name="getRange">read a packing into rangeData: same combinatorics, convert to eucl</cmd>
		<cmd name="getDomain">read a packing into domainData: same combinatorics, convert to eucl</cmd>
		<cmd name="diff">put compute complex derivative centers/rad in 'derivData'</cmd>
		<cmd name="copy" flags="{pnum}">write 'outputData' into designated packing
			<param abbrev="pnum">number of packing to copy into</param>
		</cmd>
		<cmd name="SR" flags="t">set 'outputData' a la Ruschewyeh conjecture
			<param abbrev="t">Ruschewyeh parameter in [0,1)</param>
		</cmd>
	</packextender>
	<packextender name="ConformalFlow" abbrev="CF">
	</packextender>
	<packextender name="RationalMap" abbrev="RM">
	</packextender>
	<packextender name="SchwarzianSolve" abbrev="sz">
		<tooltip>Solve spherical packings directly in intrinsic-schwarzian coordinates (fold-free closing system)</tooltip>
		<cmd name="seed" flags="[-d|-c|-z] [-p sigma]">seed edge schwarzians: -d from vertex degrees (combinatorial), -c from current geometry (set_sch), -z identically zero (blind); -p adds Gaussian noise
			<param abbrev="sigma">noise standard deviation</param>
		</cmd>
		<cmd name="residual">norm of the flower-closing (monodromy) residual; reports worst flower</cmd>
		<cmd name="solve" flags="[-i maxits] [-t tol]">Levenberg-Marquardt on the closing system over edge schwarzians; exact Jacobian by unit probes; state persists, so small -i calls step the solver visibly</cmd>
		<cmd name="layout">store solved schwarzians on edges and develop circles via the intrinsic Mobius-frame development (reports holonomy spread, near zero iff the schwarzians close up)</cmd>
		<cmd name="check">compare solved schwarzians against those recomputed from the current geometry</cmd>
		<cmd name="cont">per-flower continuant minima; negative flags a branched flower</cmd>
		<cmd name="budget" flags="[-b v1 v2 ...]">report per-flower angular budgets T_v: budget residual and predicted branch set (wraps = round(T/pi))</cmd>
		<cmd name="bsolve" flags="[-i maxits] [-t tol] [-b v1 v2 ...]">stage-1 budget-Newton: drive each T_v to pi*w to select the solution basin before 'solve'; -b lists branch vertices (w=2), else aims read from the packing (set_aim 4*pi v, as for sn)
			<param abbrev="maxits">iteration cap (default 30)</param>
			<param abbrev="tol">convergence tolerance on ||beta||_inf (default 1e-10)</param>
		</cmd>
		<cmd name="tsolve" flags="[-i maxits] [-t tol] [-b v1 v2 ...]">one-stage tail-coordinate solver: LM on the exact three closing conditions per flower (budget, stretch, shear) with the wrap vector as input (aims/-b, as bsolve); subsumes bsolve+solve, stall-free on the test bed
			<param abbrev="maxits">iteration cap (default 60)</param>
			<param abbrev="tol">convergence tolerance on ||R3||_inf (default 1e-10)</param>
		</cmd>
		<cmd name="newton" flags="[-i maxits] [-t tol] [-l v1 v2 ...]">radius chapter: damped Newton on the spherical angle-sum system (embedded SphBranchNewton); -l anchors the listed circles</cmd>
		<cmd name="perron" flags="[-k K] [-n passes] [-l v1 v2 ...]">radius chapter: Perron develop with fixed container (embedded SphBranchNewton)</cmd>
		<cmd name="rsolve">radius chapter: Perron (develop) + Newton (polish) -- the sn 'solve', renamed to avoid collision</cmd>
		<cmd name="rresidual">radius chapter: max |anglesum - aim| over interior vertices</cmd>
		<cmd name="bigcircles" flags="[-n k] [-l v1 v2 ...]">radius chapter: choose/report the fixed gauge circles</cmd>
		<cmd name="winding" flags="[-r ring] [-L]">radius chapter: ball-bearing winding number</cmd>
		<cmd name="basin1" flags="v min max N [-r ring] [-p pnum]">radius chapter: sweep one circle's radius across the basin transition</cmd>
	</packextender>
</CPdocs>
